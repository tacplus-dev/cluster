# A stub trivy for the tests (`image -q --scanners vuln --platform P --format json -o FILE IMAGE`): SSTUB/trivy.json
# is its report, or one with no vulnerability; each call is logged to SSTUB/trivy.log.
set -uo pipefail
s=${SSTUB:?SSTUB is not set}
echo "trivy $*" >> "$s/trivy.log"
out=
while [ $# -gt 0 ]; do [ "$1" = -o ] && { out=$2; shift; }; shift; done
if [ -f "$s/trivy.json" ]; then cp "$s/trivy.json" "${out:?no -o}"; else echo '{"Results":[]}' > "${out:?no -o}"; fi
